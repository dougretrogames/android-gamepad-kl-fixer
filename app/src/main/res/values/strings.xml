    <!-- Instructions Dialog -->
    <string name="instructions_title">How to Use</string>
    <string name="instructions_content" translate="false">
        &lt;b&gt;1. Connect&lt;/b&gt;&lt;br/&gt;Plug in your USB or Bluetooth gamepad.&lt;br/&gt;&lt;br/&gt;
        &lt;b&gt;2. Select&lt;/b&gt;&lt;br/&gt;Choose your device from the list.&lt;br/&gt;&lt;br/&gt;
        &lt;b&gt;3. Test Input&lt;/b&gt;&lt;br/&gt;Press buttons and move sticks to capture scan codes.&lt;br/&gt;&lt;br/&gt;
        &lt;b&gt;4. Generate KL&lt;/b&gt;&lt;br/&gt;Tap "Generate KL" to create the mapping.&lt;br/&gt;&lt;br/&gt;
        &lt;b&gt;5. Install&lt;/b&gt;&lt;br/&gt;Check Root and install. Device reboot required.
    </string>
