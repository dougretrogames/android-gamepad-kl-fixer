<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            style="@style/Widget.MaterialComponents.Toolbar.Primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/tvDeviceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="Device Name" />
                    <TextView android:id="@+id/tvVendorId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                    <TextView android:id="@+id/tvProductId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvKlFilename"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/tvSources"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <TextView android:id="@+id/tvDescriptor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/kl_preview"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:layout_marginBottom="4dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@color/kl_preview_bg_light">
                <EditText
                    android:id="@+id/tvKlPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:textSize="11sp"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:gravity="top|start"
                    android:hint="@string/kl_preview"
                    android:background="@android:color/transparent"
                    android:importantForAutofill="no" />
            </ScrollView>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:background="@color/status_bg_light"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btnTestInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/test_input_btn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnCheckRoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/check_root"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnSaveLocal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/save_local"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnInstall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/install_system"
                    android:enabled="false"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnRestore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/restore_backup"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
